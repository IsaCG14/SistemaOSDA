    rol: str = Depends(_verify_admin_role),
):
    """Obtener persona por ID (solo ADMIN)."""
    try:
        async with await _get_personas_client() as client:
            resp = await client.get(f"/rest/v1/personas?id=eq.{persona_id}")
            if resp.status_code == 200:
                data = resp.json()
                if data:
                    return data[0]
                raise HTTPException(status_code=404, detail="Persona no encontrada")
            raise HTTPException(status_code=500, detail="Error consultando persona")
    except HTTPException:
        raise
    except Exception as e:
        logger.error("obtener_persona_failed", error=str(e), persona_id=persona_id)
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/api/personas", status_code=201)
async def crear_persona(
    persona: PersonaCreate,
    request: Request,
    rol: str = Depends(_verify_admin_role),
):
    """Crear persona (solo ADMIN)."""
    try:
        async with await _get_personas_client() as client:
            data = persona.model_dump()
            import uuid
            from datetime import datetime
            data.update({
                "id": str(uuid.uuid4()),
                "creada_en": datetime.utcnow().isoformat(),
                "actualizada_en": datetime.utcnow().isoformat(),
            })
            resp = await client.post(
                "/rest/v1/personas",
                json=data,
                headers={"Prefer": "return=representation"}
            )
            if resp.status_code == 201:
                return resp.json()[0]
            if resp.status_code == 409:
                raise HTTPException(status_code=409, detail="La persona ya existe")
            raise HTTPException(status_code=500, detail="Error creando persona")
    except HTTPException:
        raise
    except Exception as e:
        logger.error("crear_persona_failed", error=str(e))
        raise HTTPException(status_code=500, detail=str(e))


