@app.get("/api/consultas/ultimo-correlativo")
async def ultimo_correlativo(
    oficina: Optional[str] = None,
    tipo_documento: Optional[str] = None,
    client: httpx.AsyncClient = Depends(get_supabase_client),
):
    """Último correlativo activo según PostgreSQL, sin réplicas obsoletas."""
    try:
        params = [
            ("select", "correlativo,fecha_documento"),
            ("eliminado_en", "is.null"),
            ("order", "fecha_documento.desc,creado_en.desc"),
            ("limit", "1"),
        ]
        if oficina:
            params.append(("oficina_origen_sigla", f"eq.{oficina}"))
        if tipo_documento:
            params.append(("tipo_doc_codigo", f"eq.{tipo_documento}"))

        resp = await client.get("/rest/v1/documentos", params=params)
        resp.raise_for_status()
        docs = resp.json()
        if not docs:
            return {"correlativo": None, "fecha": None}
        return {"correlativo": docs[0]["correlativo"], "fecha": docs[0]["fecha_documento"]}
    except HTTPException:
        raise
    except Exception as e:
        logger.error("ultimo_correlativo_failed", error=str(e))
        raise HTTPException(status_code=500, detail=str(e))


