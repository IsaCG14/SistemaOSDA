# ENDPOINTS - PERSONAS (PostgREST via Kong, con control de acceso por rol)
# ─────────────────────────────────────────────────────────────────

class PersonaCreate(BaseModel):
    nombre: str
    cargo: Optional[str] = None
    oficina_sigla: str
    telegram_user_id: Optional[int] = None
    email: Optional[str] = None
    username: Optional[str] = None
    activa: bool = True


class PersonaUpdate(BaseModel):
    nombre: Optional[str] = None
    cargo: Optional[str] = None
    oficina_sigla: Optional[str] = None
    telegram_user_id: Optional[int] = None
    email: Optional[str] = None
    username: Optional[str] = None
    activa: Optional[bool] = None


class PersonaResponse(PersonaCreate):
    id: str
    creada_en: str
    actualizada_en: Optional[str] = None


# Funciones de verificación de rol (deben estar ANTES de los endpoints que las usan)
def _caller_role(request: Request) -> Optional[str]:
    """Rol del usuario autenticado que hace la peticion (None si token invalido)."""
    from jose import jwt as jose_jwt, JWTError
    auth = request.headers.get("authorization") or request.headers.get("Authorization")
    if not auth or not auth.lower().startswith("bearer "):
        return None
    token = auth.split(" ", 1)[1].strip()
    try:
        import base64
        import json
        parts = token.split(".")
        if len(parts) < 2:
            return None
        payload_b64 = parts[1]
        padded = payload_b64 + "=" * (-len(payload_b64) % 4)
        payload_json = base64.urlsafe_b64decode(padded)
        payload_str = payload_json.decode('utf-8')
        open_braces = payload_str.count('{')
        close_braces = payload_str.count('}')
        if open_braces > close_braces:
            payload_str += '}' * (open_braces - close_braces)
        payload = json.loads(payload_str)
    except Exception:
        return None

    sub = payload.get("sub")
    if not sub or not SUPABASE_DB_PASSWORD:
        return None
    import psycopg
    try:
        conn = psycopg.connect(host="supabase-db", dbname="postgres", user="postgres",
                               password=SUPABASE_DB_PASSWORD, port=5432, connect_timeout=5)
        with conn.cursor() as cur:
            cur.execute("SELECT raw_user_meta_data->>'role' FROM auth.users WHERE id = %s", (sub,))
            fila = cur.fetchone()
        conn.close()
        return fila[0] if fila else None
    except Exception:
        return None


async def _verify_admin_role(request: Request) -> str:
    """Verifica que el usuario sea ADMIN usando el rol del JWT."""
    auth = request.headers.get("authorization") or request.headers.get("Authorization")
    if not auth or not auth.lower().startswith("bearer "):
        raise HTTPException(status_code=401, detail="No autorizado")
    
    token = auth.split(" ", 1)[1].strip()
    try:
        import base64
        import json
        
        # Decodificar JWT sin verificación de firma (token ya validado en login)
        parts = token.split(".")
        if len(parts) < 2:
            raise HTTPException(status_code=401, detail="Token inválido")
        
        payload_b64 = parts[1]
        padded = payload_b64 + "=" * (-len(payload_b64) % 4)
        payload_json = base64.urlsafe_b64decode(padded)
        payload_str = payload_json.decode('utf-8')
        
        # Manejar payloads truncados (bug conocido en GoTrue)
        open_braces = payload_str.count('{')
        close_braces = payload_str.count('}')
        if open_braces > close_braces:
            payload_str += '}' * (open_braces - close_braces)
        
        payload = json.loads(payload_str)
        user_role = payload.get("role")
        
        if user_role != "ADMIN":
            raise HTTPException(status_code=403, detail="Solo un ADMIN puede acceder a personas")
        
        return user_role
        
    except HTTPException:
        raise
    except Exception as e:
        logger.error("_verify_admin_role_failed", error=str(e))
        raise HTTPException(status_code=401, detail="Error verificando token")


# ─────────────────────────────────────────────────────────────────
# ENDPOINT UNIFICADO - USUARIOS (Auth + Persona en uno solo)
# ─────────────────────────────────────────────────────────────────
class UsuarioCreate(BaseModel):
    """Crear usuario completo: Auth + Persona en una sola llamada"""
    nombre: str
    email: str
    password: str
    cargo: Optional[str] = None
    oficina_sigla: str
    telegram_user_id: Optional[int] = None
    username: Optional[str] = None
    role: str = "SECRETARIO"  # ADMIN o SECRETARIO
    activa: bool = True


class UsuarioUpdate(BaseModel):
    """Actualizar usuario (puede actualizar Auth y/o Persona)"""
    nombre: Optional[str] = None
    email: Optional[str] = None
    password: Optional[str] = None  # Si se proporciona, actualiza en Auth
    cargo: Optional[str] = None
    oficina_sigla: Optional[str] = None
    telegram_user_id: Optional[int] = None
    username: Optional[str] = None
    role: Optional[str] = None
    activa: Optional[bool] = None


class UsuarioResponse(BaseModel):
    id: str
    nombre: str
    email: str
    cargo: Optional[str] = None
    oficina_sigla: str
    telegram_user_id: Optional[int] = None
    username: Optional[str] = None
    role: str
    activa: bool
    creada_en: str
    actualizada_en: Optional[str] = None


# Cliente para Admin API de Supabase (GoTrue)
async def _get_admin_client():
    """Cliente httpx para Admin API de Supabase (service_role)."""
    return httpx.AsyncClient(
        base_url=f"{SUPABASE_URL}/auth/v1/admin",
        headers={
            "apikey": SUPABASE_SERVICE_ROLE_KEY,
            "Authorization": f"Bearer {SUPABASE_SERVICE_ROLE_KEY}",
            "Content-Type": "application/json",
        },
        timeout=30.0,
    )


@app.post("/api/usuarios", status_code=201)
async def crear_usuario(
    usuario: UsuarioCreate,
    request: Request,
    rol: str = Depends(_verify_admin_role),
):
    """Crear usuario completo: Auth + Persona en una sola llamada (solo ADMIN)."""
    try:
        async with await _get_admin_client() as admin_client:
            # 1. Crear usuario en Supabase Auth
            auth_data = {
                "email": usuario.email,
                "password": usuario.password,
                "email_confirm": True,
                "user_metadata": {
                    "nombre": usuario.nombre,
                    "role": usuario.role,
                },
            }
            if usuario.username:
                auth_data["user_metadata"]["username"] = usuario.username
            
            auth_resp = await admin_client.post("/users", json=auth_data)
            # Supabase Auth returns 200 on success (not 201)
            if auth_resp.status_code not in (200, 201):
                error_detail = auth_resp.json().get("msg", "Error creando usuario en Auth")
                logger.error("crear_usuario_auth_failed", 
                    error=error_detail,
                    status_code=auth_resp.status_code,
                    response=auth_resp.text)
                raise HTTPException(status_code=400, detail=f"Error creando usuario en Auth: {error_detail} (status: {auth_resp.status_code})")
            
            auth_user = auth_resp.json()
            user_id = auth_user["id"]
            
            # 2. Crear persona en tabla personas
            async with await _get_personas_client() as client:
                from datetime import datetime
                persona_data = {
                    "id": user_id,
                    "nombre": usuario.nombre,
                    "email": usuario.email,
                    "cargo": usuario.cargo,
                    "oficina_sigla": usuario.oficina_sigla,
                    "telegram_user_id": usuario.telegram_user_id,
                    "username": usuario.username,
                    "activa": usuario.activa,
                    "creada_en": datetime.utcnow().isoformat(),
                    "actualizada_en": datetime.utcnow().isoformat(),
                }
                resp = await client.post(
                    "/rest/v1/personas",
                    json=persona_data,
                    headers={"Prefer": "return=representation"}
                )
                if resp.status_code == 201:
                    persona = resp.json()[0]
                    return UsuarioResponse(
                        **{k: v for k, v in persona.items() if k != 'email'},
                        email=usuario.email,
                        role=usuario.role,
                    )
                elif resp.status_code == 409:
                    # Si falla la persona, intentar limpiar el usuario de Auth
                    await admin_client.delete(f"/users/{user_id}")
                    raise HTTPException(status_code=409, detail="La persona ya existe")
                else:
                    # Si falla la persona, limpiar el usuario de Auth
                    await admin_client.delete(f"/users/{user_id}")
                    raise HTTPException(status_code=500, detail="Error creando persona")
                    
    except HTTPException:
        raise
    except Exception as e:
        logger.error("crear_usuario_failed", error=str(e))
        raise HTTPException(status_code=500, detail=str(e))


@app.patch("/api/usuarios/{usuario_id}")
async def actualizar_usuario(
    usuario_id: str,
    usuario: UsuarioUpdate,
    request: Request,
    rol: str = Depends(_verify_admin_role),
):
    """Actualizar usuario completo: Auth y/o Persona (solo ADMIN)."""
    try:
        async with await _get_admin_client() as admin_client:
            # 1. Actualizar en Auth si hay cambios de email, password o role
            auth_updates = {}
            if usuario.email is not None:
                auth_updates["email"] = usuario.email
            if usuario.password is not None:
                auth_updates["password"] = usuario.password
            if usuario.role is not None or usuario.nombre is not None or usuario.username is not None:
                # Obtener user_metadata actual
                get_resp = await admin_client.get(f"/users/{usuario_id}")
                if get_resp.status_code == 200:
                    current_user = get_resp.json()
                    current_metadata = current_user.get("user_metadata", {})
                    if usuario.nombre is not None:
                        current_metadata["nombre"] = usuario.nombre
                    if usuario.username is not None:
                        current_metadata["username"] = usuario.username
                    if usuario.role is not None:
                        current_metadata["role"] = usuario.role
                    auth_updates["user_metadata"] = current_metadata
            
            if auth_updates:
                auth_resp = await admin_client.put(f"/users/{usuario_id}", json=auth_updates)
                if auth_resp.status_code != 200:
                    error_detail = auth_resp.json().get("msg", "Error actualizando usuario en Auth")
                    logger.error("actualizar_usuario_auth_failed", error=error_detail)
                    raise HTTPException(status_code=400, detail=error_detail)
            
            # 2. Actualizar en tabla personas
            async with await _get_personas_client() as client:
                from datetime import datetime
                data = usuario.model_dump(exclude_unset=True, exclude={"email", "password", "role"})
                if not data:
                    # Solo actualizar metadata de Auth
                    get_resp = await admin_client.get(f"/users/{usuario_id}")
                    if get_resp.status_code == 200:
                        current_user = get_resp.json()
                        return UsuarioResponse(
                            id=usuario_id,
                            **current_user.get("user_metadata", {}),
                            email=current_user.get("email", ""),
                            role=current_user.get("user_metadata", {}).get("role", "SECRETARIO"),
                        )
                
                data["actualizada_en"] = datetime.utcnow().isoformat()
                resp = await client.patch(
                    f"/rest/v1/personas?id=eq.{usuario_id}",
                    json=data,
                    headers={"Prefer": "return=representation"}
                )
                if resp.status_code == 200:
                    persona = resp.json()[0]
                    # Obtener info de Auth para response completo
                    get_resp = await admin_client.get(f"/users/{usuario_id}")
                    if get_resp.status_code == 200:
                        auth_user = get_resp.json()
                        return UsuarioResponse(
                            **{k: v for k, v in persona.items() if k != 'email'},
                            email=auth_user.get("email", ""),
                            role=auth_user.get("user_metadata", {}).get("role", "SECRETARIO"),
                        )
                    # Fallback: try to get email from persona or use empty string
                    return UsuarioResponse(
                        **{k: v for k, v in persona.items() if k != 'email'},
                        email=persona.get("email", ""),
                        role="SECRETARIO",
                    )
                raise HTTPException(status_code=500, detail="Error actualizando persona")
                    
    except HTTPException:
        raise
    except Exception as e:
        logger.error("actualizar_usuario_failed", error=str(e))
        raise HTTPException(status_code=500, detail=str(e))


@app.delete("/api/usuarios/{usuario_id}")
async def eliminar_usuario(
    usuario_id: str,
    request: Request,
    rol: str = Depends(_verify_admin_role),
):
    """Eliminar usuario completo: Auth + Persona (solo ADMIN)."""
    try:
        # 1. Eliminar de Auth
        async with await _get_admin_client() as admin_client:
            auth_resp = await admin_client.delete(f"/users/{usuario_id}")
            # No fallar si no existe en Auth (puede que ya se haya borrado)
        
        # 2. Eliminar de personas
        async with await _get_personas_client() as client:
            resp = await client.delete(
                f"/rest/v1/personas?id=eq.{usuario_id}",
                headers={"Prefer": "return=representation"}
            )
            if resp.status_code == 200:
                return {"message": "Usuario eliminado", "id": usuario_id}
            return {"message": "Usuario eliminado de Auth", "id": usuario_id}
            
    except Exception as e:
        logger.error("eliminar_usuario_failed", error=str(e))
        raise HTTPException(status_code=500, detail=str(e))


async def _get_personas_client():
    """Cliente HTTP para PostgREST via Kong."""
    return httpx.AsyncClient(
        base_url="http://supabase-kong:8000",
        headers={
            "apikey": SUPABASE_SERVICE_ROLE_KEY,
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
        timeout=30.0,
    )


@app.get("/api/personas")
async def listar_personas(
    request: Request,
    limit: int = 50,
    offset: int = 0,
    active_only: bool = True,
    rol: str = Depends(_verify_admin_role),
):
    """Listar personas con rol real desde auth.users (solo ADMIN)."""
    try:
        import psycopg
        if not SUPABASE_DB_PASSWORD:
            raise HTTPException(status_code=500, detail="SUPABASE_DB_PASSWORD no configurada")
        
        conn = psycopg.connect(
            host="supabase-db",
            dbname="postgres",
            user="postgres",
            password=SUPABASE_DB_PASSWORD,
            port=5432,
            connect_timeout=5,
        )
        
        with conn.cursor() as cur:
            # Query con JOIN para obtener rol real de auth.users
            query = """
                SELECT 
                    p.id, p.nombre, p.cargo, p.oficina_sigla, 
                    p.telegram_user_id, p.email, p.username, p.activa,
                    p.creada_en, p.actualizada_en,
                    COALESCE(u.raw_user_meta_data->>'role', 'SECRETARIO') as role
                FROM public.personas p
                LEFT JOIN auth.users u ON p.id = u.id
            """
            params = []
            
            if active_only:
                query += " WHERE p.activa = true"
            
            query += " ORDER BY p.creada_en DESC LIMIT %s OFFSET %s"
            params.extend([limit, offset])
            
            cur.execute(query, params)
            columns = [desc[0] for desc in cur.description]
            rows = cur.fetchall()
        
        conn.close()
        
        # Convertir a lista de diccionarios
        result = []
        for row in rows:
            item = dict(zip(columns, row))
            # Convertir timestamps a string si es necesario
            for key in ['creada_en', 'actualizada_en']:
                if item.get(key) and hasattr(item[key], 'isoformat'):
                    item[key] = item[key].isoformat()
            result.append(item)
        
        return result
        
    except HTTPException:
        raise
    except Exception as e:
        logger.error("listar_personas_failed", error=str(e))
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/api/personas/{persona_id}")
async def obtener_persona(
    persona_id: str,
