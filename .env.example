# .env.example — plantilla de configuración del Sistema OSDA
# Copiar a .env y completar con valores REALES. NUNCA commitear .env
# cp .env.example .env

# ─────────────────────────────────────────────────────────────────
# ENTORNO
# ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production
SITE_URL=http://localhost
TZ=America/Caracas

# ─────────────────────────────────────────────────────────────────
# SUPABASE (self-hosted en este stack)
# Generar valores con: openssl rand -base64 32
# Las API keys son JWT firmados con SUPABASE_JWT_SECRET (ver docs/setup)
# ─────────────────────────────────────────────────────────────────
SUPABASE_DB_PASSWORD=cambia_esta_password
SUPABASE_JWT_SECRET=genera_con_openssl_rand_base64_32
SUPABASE_ANON_KEY=pega_aqui_el_jwt_anon_generado
SUPABASE_SERVICE_ROLE_KEY=pega_aqui_el_jwt_service_role_generado

# ─────────────────────────────────────────────────────────────────
# TELEGRAM BOT (obtener en @BotFather)
# ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAAATuTokenDeBotFatherAqui
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890
TELEGRAM_DOCUMENT_TOPIC_ID=
# TELEGRAM_ALLOWED_USER_IDS=123456789

# ─────────────────────────────────────────────────────────────────
# VISION / OLLAMA
# ─────────────────────────────────────────────────────────────────
VISION_PROVIDER=ollama
VISION_MODEL=gemma4:cloud
NVIDIA_API_KEY=nvapi-tu_api_key_de_nvidia_aqui
OLLAMA_HOST=http://ollama:11434

# ─────────────────────────────────────────────────────────────────
# GRAPHIFY
# ─────────────────────────────────────────────────────────────────
GRAPHIFY_INDEX_NAME=osda_docs
GRAPHIFY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─────────────────────────────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────────────────────────────
STORAGE_BUCKET_NAME=documentos
MAX_UPLOAD_SIZE_MB=20
ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# ─────────────────────────────────────────────────────────────────
# BACKUP
# ─────────────────────────────────────────────────────────────────
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
RETENTION_DAYS=2555

# ─────────────────────────────────────────────────────────────────
# PROXY CORPORATIVO (ajustar segun la red de la institucion)
# ─────────────────────────────────────────────────────────────────
HTTP_PROXY=http://tu-proxy-corporativo:3128
HTTPS_PROXY=http://tu-proxy-corporativo:3128
NO_PROXY=localhost,127.0.0.0/8,::1,backend,ollama,postgres,supabase-kong,supabase-*,graphify,neo4j,192.168.0.0/16,172.16.0.0/12

# ─────────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────────
APP_SECRET_KEY=genera_con_openssl_rand_base64_32
