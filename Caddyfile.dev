# Caddyfile - HTTP Interno Simple (Testing LAN)
# Dominio: corpocentro.osda.net (resuelve a 192.168.251.203)

{
    admin off
    log {
        output stdout
        format json
    }
}

# Frontend + API + Graphify en HTTP - Acepta múltiples hosts
http://corpocentro.osda.net:8880, http://localhost:8880, http://127.0.0.1:8880, http://192.168.251.203:8880, http://100.81.239.93:8880, http://*.tailnet.ts.net:8880 {
    # DELETE /api/personas/{uuid} -> Backend (with role-based access control)
    # DEBE IR PRIMERO para que se evalúe antes que /api/personas*
    @deletePersona {
        method DELETE
        path_regexp ^/api/personas/[0-9a-f-]{36}$
    }
    handle @deletePersona {
        reverse_proxy backend:8000 {
            transport http {
                versions h1
            }
        }
    }

    # Personas CRUD (via Backend with role-based access control)
    # DEBE ir ANTES que /api* general
    handle /api/personas* {
        reverse_proxy backend:8000 {
            transport http {
                versions h1
            }
        }
    }

    # Configuración general - DEBE ir ANTES que /api* general
    handle /api/configuracion* {
        reverse_proxy backend:8000 {
            transport http {
                versions h1
            }
        }
    }

    # Frontend (React) - Producción (nginx sirviendo archivos estáticos)
    # Debe ir ANTES que el catch-all del backend
    handle /assets* {
        reverse_proxy osda-frontend:80
    }
    handle /fonts* {
        reverse_proxy osda-frontend:80
    }
    handle /favicon.ico {
        reverse_proxy osda-frontend:80
    }
    handle /robots.txt {
        reverse_proxy osda-frontend:80
    }
    handle /manifest.json {
        reverse_proxy osda-frontend:80
    }

    # Health check endpoint - DEBE ir ANTES del catch-all
    handle /health {
        reverse_proxy backend:8000 {
            transport http {
                versions h1
            }
        }
    }

    # Auth (Supabase/Kong) via /api prefix - DEBE IR ANTES que /api* general
    handle /api/auth* {
        uri strip_prefix /api
        reverse_proxy supabase-kong:8000 {
            transport http {
                versions h1
            }
        }
    }

    # Backend API (FastAPI) - excluye /api/auth y /api/personas
    handle /api* {
        reverse_proxy backend:8000 {
            transport http {
                versions h1
            }
        }
    }

    # Graphify
    handle /graphify* {
        reverse_proxy graphify:8080
    }

    # Webhook Telegram (para compatibilidad, aunque usemos polling)
    handle /webhook/telegram* {
        reverse_proxy backend:8000 {
            transport http {
                versions h1
            }
        }
    }

    # Supabase Auth (GoTrue via Kong) - direct path
    handle /auth* {
        reverse_proxy supabase-kong:8000 {
            transport http {
                versions h1
            }
        }
    }

    # PostgREST via Kong - direct path
    handle /rest* {
        reverse_proxy supabase-kong:8000 {
            transport http {
                versions h1
            }
        }
    }

    # Frontend (React) - Catch-all para SPA routing
    # DEBE IR AL FINAL, después de todos los handles específicos
    handle {
        reverse_proxy osda-frontend:80 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# Servicios internos (red Docker)
http://backend:8000 {
    reverse_proxy backend:8000
}

http://graphify:8080 {
    reverse_proxy graphify:8080
}

http://kong:8000 {
    reverse_proxy supabase-kong:8000
}